# 大模型 API 凭据（支持任何兼容 OpenAI 协议的模型，如 DeepSeek、通义千问等）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL_NAME=deepseek-v4-flash

# NapCat (OneBot 11) 网络网关配置
NAPCAT_HTTP_URL=http://127.0.0.1:3000
BOT_QQ=0
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Fish Audio 语音配置（注册 fish.audio 获取 API Key）
FISH_AUDIO_API_KEY=your_fish_audio_key_here
# 可选：声线模型 ID（在 fish.audio/models 中选择弱气/害羞日漫声线）
FISH_AUDIO_VOICE_ID=7f92f8afb8ec43bf81429cc1c9199cb1